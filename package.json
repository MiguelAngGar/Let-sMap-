{
  "name": "lets-map",
  "version": "0.3.0",
  "description": "Automatic Beat Saber song prep tool",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --enable-logging",
    "dist:mac": "electron-builder --mac --arm64 --config.directories.output=dist/mac",
    "dist:mac-intel": "electron-builder --mac --x64 --config.directories.output=dist/mac-intel",
    "dist:win": "electron-builder --win --x64",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.cobayo.letsmap",
    "productName": "Let'sMap!",
    "copyright": "Cobayo 2026",
    "files": [
      "electron/**/*",
      "pipeline/**/*",
      "python/**/*",
      "renderer/**/*",
      "node_modules/**/*",
      "!python/.venv/**/*",
      "!python/dist/**/*",
      "!python/build/**/*",
      "!python/**/__pycache__/**/*",
      "!**/*.pyc",
      "!**/*.pyo"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.music"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "dmg": {
      "title": "Let'sMap! ${version}"
    },
    "asarUnpack": [
      "node_modules/ffmpeg-static/**/*",
      "python/dist/**/*",
      "python/analyze.py",
      "pipeline/av-engine/**/*"
    ]
  },
  "devDependencies": {
    "electron": "^29.0.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "electron-store": "^8.2.0",
    "ffmpeg-static": "^5.2.0",
    "fluent-ffmpeg": "^2.1.3",
    "jimp": "^0.22.12"
  }
}
